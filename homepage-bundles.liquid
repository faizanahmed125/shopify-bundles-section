{% liquid
  assign section_heading = section.settings.heading | default: 'Featured bundles'
%}

<section class="bundle-section" aria-labelledby="BundleHeading-{{ section.id }}">
  <div class="page-width">
    <h2 id="BundleHeading-{{ section.id }}" class="bundle-section__heading">
      {{ section_heading | escape }}
    </h2>

    <div class="bundle-section__grid">
      {% for block in section.blocks %}
        {% liquid
          assign featured_collection = block.settings.collection
          assign featured_product = featured_collection.products.first
          assign featured_image = featured_collection.image | default: featured_product.featured_image
        %}

        {% if featured_collection != blank %}
          <article class="bundle-card" {{ block.shopify_attributes }}>
            {% if block.settings.badge != blank %}
              <span class="bundle-card__badge">{{ block.settings.badge | escape }}</span>
            {% endif %}

            {% if block.settings.savings_label != blank %}
              <span class="bundle-card__saving">{{ block.settings.savings_label | escape }}</span>
            {% endif %}

            <a class="bundle-card__media" href="{{ featured_collection.url }}" aria-label="{{ featured_collection.title | escape }}">
              {% if featured_image != blank %}
                {{
                  featured_image
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    widths: '360, 540, 720, 900',
                    sizes: '(min-width: 990px) 30vw, 90vw',
                    alt: featured_collection.title
                }}
              {% else %}
                {{ 'collection-1' | placeholder_svg_tag: 'bundle-card__placeholder' }}
              {% endif %}
            </a>

            <div class="bundle-card__content">
              <h3 class="bundle-card__title">
                <a href="{{ featured_collection.url }}">{{ featured_collection.title | escape }}</a>
              </h3>

              {% if featured_collection.description != blank %}
                <p class="bundle-card__description">
                  {{ featured_collection.description | strip_html | truncatewords: 18 }}
                </p>
              {% endif %}

              <div class="bundle-card__footer">
                {% if featured_product != blank %}
                  <div class="bundle-card__pricing">
                    <span class="bundle-card__price">{{ featured_product.price | money }}</span>
                    {% if featured_product.compare_at_price > featured_product.price %}
                      <s class="bundle-card__compare-price">{{ featured_product.compare_at_price | money }}</s>
                    {% endif %}
                  </div>
                {% endif %}

                <a class="bundle-card__button" href="{{ featured_collection.url }}">
                  {{ block.settings.button_label | default: 'View bundle' | escape }}
                </a>
              </div>
            </div>
          </article>
        {% else %}
          <article class="bundle-card bundle-card--placeholder" {{ block.shopify_attributes }}>
            {{ 'collection-1' | placeholder_svg_tag: 'bundle-card__placeholder' }}
            <div class="bundle-card__content">
              <h3 class="bundle-card__title">Choose a collection</h3>
              <p class="bundle-card__description">Select a collection in this block's theme-editor settings.</p>
            </div>
          </article>
        {% endif %}
      {% else %}
        {% for index in (1..3) %}
          <article class="bundle-card bundle-card--placeholder">
            {{ 'collection-1' | placeholder_svg_tag: 'bundle-card__placeholder' }}
            <div class="bundle-card__content">
              <h3 class="bundle-card__title">Bundle {{ index }}</h3>
              <p class="bundle-card__description">Add and configure a collection block in the theme editor.</p>
            </div>
          </article>
        {% endfor %}
      {% endfor %}
    </div>
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} {
    --bundle-background: {{ section.settings.background_color }};
    --bundle-card-background: {{ section.settings.card_color }};
    --bundle-text: {{ section.settings.text_color }};
    --bundle-accent: {{ section.settings.accent_color }};
    --bundle-button: {{ section.settings.button_color }};
    --bundle-button-text: {{ section.settings.button_text_color }};
  }

  #shopify-section-{{ section.id }} .bundle-section {
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
    background: var(--bundle-background);
  }

  #shopify-section-{{ section.id }} .bundle-section__heading {
    margin: 0 0 40px;
    color: var(--bundle-text);
    font-family: var(--font-heading-family, serif);
    font-size: clamp(2rem, 4vw, 2.75rem);
    text-align: center;
  }

  #shopify-section-{{ section.id }} .bundle-section__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(24px, 4vw, 56px);
  }

  #shopify-section-{{ section.id }} .bundle-card {
    position: relative;
    display: flex;
    min-width: 0;
    flex-direction: column;
    padding: 20px;
    border: 1px solid color-mix(in srgb, var(--bundle-text) 10%, transparent);
    border-radius: 10px;
    background: var(--bundle-card-background);
    box-shadow: 0 10px 30px rgb(0 0 0 / 6%);
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  #shopify-section-{{ section.id }} .bundle-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 36px rgb(0 0 0 / 10%);
  }

  #shopify-section-{{ section.id }} .bundle-card__badge,
  #shopify-section-{{ section.id }} .bundle-card__saving {
    position: absolute;
    z-index: 2;
    color: var(--bundle-button-text);
    font-size: 11px;
    font-weight: 700;
    line-height: 1.2;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .bundle-card__badge {
    top: -10px;
    left: -10px;
    padding: 7px 14px;
    background: var(--bundle-button);
    box-shadow: 4px 4px 0 var(--bundle-accent);
  }

  #shopify-section-{{ section.id }} .bundle-card__saving {
    top: -24px;
    right: 8px;
    display: grid;
    width: 58px;
    min-height: 58px;
    padding: 6px;
    place-items: center;
    border-radius: 50%;
    background: var(--bundle-accent);
    text-align: center;
  }

  #shopify-section-{{ section.id }} .bundle-card__media {
    display: block;
    overflow: hidden;
    border-radius: 6px;
    background: color-mix(in srgb, var(--bundle-text) 7%, transparent);
  }

  #shopify-section-{{ section.id }} .bundle-card__media img,
  #shopify-section-{{ section.id }} .bundle-card__placeholder {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .bundle-card__content {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding-top: 20px;
  }

  #shopify-section-{{ section.id }} .bundle-card__title {
    margin: 0 0 10px;
    color: var(--bundle-text);
    font-family: var(--font-heading-family, serif);
    font-size: 1.35rem;
    line-height: 1.25;
  }

  #shopify-section-{{ section.id }} .bundle-card__title a {
    color: inherit;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .bundle-card__description {
    margin: 0 0 18px;
    color: color-mix(in srgb, var(--bundle-text) 70%, transparent);
    line-height: 1.6;
  }

  #shopify-section-{{ section.id }} .bundle-card__footer {
    margin-top: auto;
  }

  #shopify-section-{{ section.id }} .bundle-card__pricing {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 14px;
  }

  #shopify-section-{{ section.id }} .bundle-card__price {
    color: var(--bundle-text);
    font-size: 1.25rem;
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .bundle-card__compare-price {
    opacity: 0.55;
    font-size: 0.9rem;
  }

  #shopify-section-{{ section.id }} .bundle-card__button {
    display: block;
    padding: 13px 18px;
    border-radius: 6px;
    background: var(--bundle-button);
    color: var(--bundle-button-text);
    font-weight: 700;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .bundle-card__button:focus-visible,
  #shopify-section-{{ section.id }} .bundle-card__title a:focus-visible,
  #shopify-section-{{ section.id }} .bundle-card__media:focus-visible {
    outline: 2px solid var(--bundle-accent);
    outline-offset: 3px;
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .bundle-section__grid {
      grid-template-columns: 1fr;
      max-width: 520px;
      margin-inline: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .bundle-card {
      transition: none;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Collection bundles",
  "tag": "section",
  "class": "section-collection-bundles",
  "max_blocks": 3,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Featured bundles"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#efeccb"
    },
    {
      "type": "color",
      "id": "card_color",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#003865"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#c5a059"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button",
      "default": "#003865"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top spacing",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom spacing",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "bundle",
      "name": "Bundle",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
          "default": "Featured"
        },
        {
          "type": "text",
          "id": "savings_label",
          "label": "Savings label",
          "default": "Save 15%"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "View bundle"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection bundles",
      "blocks": [
        { "type": "bundle" },
        { "type": "bundle" },
        { "type": "bundle" }
      ]
    }
  ]
}
{% endschema %}
